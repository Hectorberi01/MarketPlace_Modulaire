# Copier en `.env` (cd deploy && cp .env.example .env) puis renseigner les secrets.
# docker compose lit automatiquement deploy/.env. NE METS PAS de vraies valeurs
# dans CE fichier : il est commité. Les secrets vont uniquement dans .env (ignoré).

# --- Postgres ---
POSTGRES_DB=marketplace
POSTGRES_USER=postgres
# Mot de passe de la base (à définir dans .env, pas ici).
POSTGRES_PASSWORD=change_me_postgres_password

# --- JWT (DOIT être identique pour l'Api et les 4 BFF) ---
# Au moins 32 octets. Génère par ex. :  openssl rand -base64 48
JWT_SIGNING_KEY=change_me_dev_only_signing_key_at_least_32_bytes_long!!

# --- FedaPay (paiements) ---
# Clé secrète sandbox/live depuis ton tableau de bord FedaPay (sk_sandbox_… / sk_live_…).
# Vide = adaptateur stub (parcours testable sans compte). Renseignée = paiements réels.
FEDAPAY_API_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Versements réels (retraits vendeur) : true = payout FedaPay réel (nécessite FEDAPAY_API_KEY) ; false = simulé.
FEDAPAY_ENABLE_PAYOUTS=false

# --- Cloudinary (traitement image : détourage IA + fond blanc) ---
# Depuis le Dashboard Cloudinary (Product Environment Credentials). Add-on
# "AI Background Removal" requis. Vide = pas de détourage (image inchangée).
CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Détourage d'image (local, gratuit) ────────────────────────────────────────
# LAISSER REMBG_URL COMMENTÉE dans le cas courant : le compose pointe alors sur le
# service `rembg` du réseau interne.
#
# La DÉCOMMENTER en la laissant vide DÉSACTIVE la fonction (image inchangée, et les
# interfaces cessent de promettre un détourage) et fait retomber sur Cloudinary s'il
# est configuré. C'est le seul commutateur d'arrêt : la substitution du compose
# distingue « variable absente » de « variable vide ».
#
# ⚠️ NE PAS mettre un modèle BRIA (« bria-rmbg ») dans REMBG_MODEL : poids en
# CC BY-NC 4.0, usage commercial interdit. Seuls les modèles de la famille U²-Net
# sont acceptés par le code ; toute autre valeur retombe sur u2net.
#REMBG_URL=
REMBG_MODEL=u2net
# Ressources du conteneur. REMBG_THREADS borne les détourages SIMULTANÉS (et les
# threads ONNX) : sans lui, rembg en tenterait jusqu'à quarante de front.
REMBG_CPUS=2
REMBG_MEMORY=2G
REMBG_THREADS=2

# ─────────────────────────────────────────────────────────────────────────────
# E-MAILS TRANSACTIONNELS (Resend) — OBLIGATOIRE EN PRODUCTION.
# L'API refuse de démarrer sans, et c'est voulu : sans e-mail, personne ne peut
# vérifier son adresse ni récupérer un mot de passe oublié.
# Le domaine de EMAIL_FROM doit être vérifié chez Resend (SPF + DKIM).
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE DE DISPATCH (livraison par coursier)
#
# Déployé à part du monolithe, avec sa PROPRE base : il réécrit des positions de
# coursier à la seconde, la marketplace tient de l'argent (CDC §11).
# ─────────────────────────────────────────────────────────────────────────────

# Base dédiée. En développement, laisser vide : le compose monte un Postgres
# « postgres-dispatch » (port hôte 5435). En staging et en production, OBLIGATOIRE.
DISPATCH_CONNECTION=
DISPATCH_DB=dispatch
DISPATCH_DB_USER=postgres
DISPATCH_DB_PASSWORD=

# PART DES FRAIS DE LIVRAISON VERSÉE AU COURSIER. OBLIGATOIRE — le service REFUSE DE
# DÉMARRER sans elle, dans tous les environnements.
#
# Aucune valeur par défaut n'existe dans le code, et c'est délibéré : un défaut à 0.80
# serait une décision commerciale prise par accident, que personne n'aurait relue et
# qu'on découvrirait au premier relevé de compte. Notation à POINT décimal.
# La règle définitive (base + km + points de ramassage) reste à arrêter — voir
# docs/PLAN_Reste_A_Faire.md §5.3.
DISPATCH_COURIER_SHARE=0.80

# DEUX SECRETS DISTINCTS, UN PAR SENS. Une fuite d'un côté ne doit pas ouvrir les deux.
#   DISPATCH_OUTBOUND_SECRET  : marketplace → dispatch (commande prête, annulation,
#                               statut coursier). En-tête X-Marketplace-Signature.
#   DELIVERY_WEBHOOK_SECRET   : dispatch → marketplace (course livrée → CRÉDIT DU
#                               COURSIER). En-tête X-Delivery-Signature.
#
# Vides en développement : les deux services acceptent alors les appels non signés.
# En staging et en production, ABSENTS = démarrage refusé — et c'est voulu : la seconde
# route fait sortir de l'argent du portefeuille de la plateforme.
#   openssl rand -hex 32
DISPATCH_OUTBOUND_SECRET=
DELIVERY_WEBHOOK_SECRET=

# Plafond ABSOLU d'une rémunération de course, en XOF. Facultatif : le plafond RELATIF
# — jamais plus que les frais de livraison encaissés sur la commande — s'applique
# toujours, sans réglage, et suffit déjà. Celui-ci est le filet contre une commande dont
# les frais seraient eux-mêmes aberrants.
COURIER_PAY_MAX_AMOUNT=

# Backplane SignalR du hub coursier. Par défaut, le Redis de la pile. Nécessaire dès que
# le service tourne en PLUSIEURS instances : sans lui, un coursier connecté à l'une ne
# reçoit jamais une offre dispatchée par l'autre.
#DISPATCH_REDIS_CONNECTION=

# Origines autorisées du SITE ACHETEUR (BFF Client).
# Depuis la fusion des BFF Mobile et Web, cette surface sert l'application mobile ET le
# site. L'application native n'a pas d'origine ; le site, lui, appelle en cross-origin.
# VIDE = REPLI FERMÉ. Liste séparée par des virgules.
CLIENT_WEB_ORIGINS=

# Origines autorisées de la CONSOLE WEB COURSIER (BFF Driveur).
# VIDE = REPLI FERMÉ : aucune origine navigateur acceptée. C'est délibéré — un repli
# ouvert combiné à AllowCredentials laisserait n'importe quel site lire le portefeuille
# d'un coursier connecté. Liste séparée par des virgules.
DRIVER_CONSOLE_ORIGINS=

# Adresses internes (réseau Docker). À laisser telles quelles sauf déploiement atypique.
#DISPATCH_BASE_URL=http://dispatch:8080
#MARKETPLACE_BASE_URL=http://api:8080
