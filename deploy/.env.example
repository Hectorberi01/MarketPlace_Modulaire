
POSTGRES_DB=marketplace
POSTGRES_USER=postgres
# La base tourne dans son propre conteneur : renseigner MARKETPLACE_CONNECTION avec
# le NOM DU SERVICE de ce conteneur (ex. Host=db;Port=5432), après l'avoir rattaché
# au réseau `marketplace-net`. Voir deploy/README.md. POSTGRES_* ne sert plus ici.
#MARKETPLACE_CONNECTION=
POSTGRES_PASSWORD=change_me_postgres_password

KYB_ENDPOINT=

# Chiffre les secrets des fournisseurs (PSP, Resend, Twilio) stockés en base.
# Vide en développement = clé de dev publique ; refusée en production, où
# l'absence de clé fait échouer le démarrage.  openssl rand -base64 32
PLATFORM_SECRET_KEY=

# --- JWT ---
# Au moins 32 octets. Génère par ex. :  openssl rand -base64 48
JWT_SIGNING_KEY=change_me_dev_only_signing_key_at_least_32_bytes_long!!

# --- FedaPay (paiements) ---
# Clé secrète sandbox/live depuis ton tableau de bord FedaPay (sk_sandbox_… / sk_live_…).
# Vide = adaptateur stub (parcours testable sans compte). Renseignée = paiements réels.
FEDAPAY_API_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Versements réels (retraits vendeur) : true = payout FedaPay réel (nécessite FEDAPAY_API_KEY) ; false = simulé.
FEDAPAY_ENABLE_PAYOUTS=false

# --- Cloudinary (traitement image : détourage IA + fond blanc) ---
# Depuis le Dashboard Cloudinary (Product Environment Credentials). Add-on
# "AI Background Removal" requis. Vide = pas de détourage (image inchangée).
CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Détourage d'image (local, gratuit) ────────────────────────────────────────
# LAISSER REMBG_URL COMMENTÉE dans le cas courant : le compose pointe alors sur le
# service `rembg` du réseau interne.
#
# La DÉCOMMENTER en la laissant vide DÉSACTIVE la fonction (image inchangée, et les
# interfaces cessent de promettre un détourage) et fait retomber sur Cloudinary s'il
# est configuré. C'est le seul commutateur d'arrêt : la substitution du compose
# distingue « variable absente » de « variable vide ».
#
# ⚠️ NE PAS mettre un modèle BRIA (« bria-rmbg ») dans REMBG_MODEL : poids en
# CC BY-NC 4.0, usage commercial interdit. Seuls les modèles de la famille U²-Net
# sont acceptés par le code ; toute autre valeur retombe sur u2net.
#REMBG_URL=
REMBG_MODEL=u2net
# Ressources du conteneur. REMBG_THREADS borne les détourages SIMULTANÉS (et les
# threads ONNX) : sans lui, rembg en tenterait jusqu'à quarante de front.
REMBG_CPUS=2
REMBG_MEMORY=2G
REMBG_THREADS=2

# ─────────────────────────────────────────────────────────────────────────────
# E-MAILS TRANSACTIONNELS (Resend) — OBLIGATOIRE EN PRODUCTION.
# L'API refuse de démarrer sans, et c'est voulu : sans e-mail, personne ne peut
# vérifier son adresse ni récupérer un mot de passe oublié.
# Le domaine de EMAIL_FROM doit être vérifié chez Resend (SPF + DKIM).
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# LE SERVICE DE DISPATCH A ÉTÉ RETIRÉ LE 09/10/2026.
#
# Ses variables — DISPATCH_CONNECTION, DISPATCH_DB*, DISPATCH_COURIER_SHARE,
# DISPATCH_OUTBOUND_SECRET, DELIVERY_WEBHOOK_SECRET, COURIER_PAY_MAX_AMOUNT,
# DISPATCH_REDIS_CONNECTION, DISPATCH_BASE_URL, DRIVER_CONSOLE_ORIGINS — n'existent
# plus : plus un seul `IConfiguration` ne les lit. Les laisser dans un `.env` est sans
# effet, mais un secret inutile qui traîne est un secret qu'on oublie de roter.
#
# La plateforme ne prend plus la livraison en charge. Voir docs/25-retrait-livraison.md.
# ─────────────────────────────────────────────────────────────────────────────

# Origines navigateur autorisées, UNE LISTE PAR SURFACE. L'application native n'a pas
# d'origine ; le site et les consoles, eux, appellent en cross-origin (et ouvrent le hub
# de messagerie depuis le navigateur).
#
# Jamais une liste commune : les trois surfaces partagent l'origine serveur de l'hôte,
# donc une liste unique autoriserait la vitrine à appeler /api/admin.
# VIDE = REPLI FERMÉ. Liste séparée par des virgules.
CLIENT_CORS_ORIGINS=
SELLER_CORS_ORIGINS=
ADMIN_CORS_ORIGINS=

# Adresses internes (réseau Docker). À laisser telles quelles sauf déploiement atypique.
#MARKETPLACE_BASE_URL=http://api:8080

# ═══════════════════════════════════════════════════════════════════════════════
# STOCKAGE OBJET DES PIÈCES KYB — MinIO local par défaut.
#
# Le compose de développement démarre un MinIO et crée le bucket. Il n'y a donc
# RIEN à renseigner ici pour que le chemin réel de stockage soit exercé : c'est le
# point de ce service. Jusqu'ici, faute d'identifiants, c'est le stub hors-ligne
# qui répondait et ce chemin n'était jamais testé hors production.
#
# Console d'administration : http://127.0.0.1:9001 (minioadmin / minioadmin)
# ═══════════════════════════════════════════════════════════════════════════════
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# DOIT correspondre à la région avec laquelle l'application signe. Une divergence
# donne « SignatureDoesNotMatch », un message qui ne dit pas que la région est en cause.
MINIO_REGION=us-east-1
KYB_BUCKET=hbaexpress-kyb

# Ces trois variables ne servent qu'au profil `with-minio`. KYB_ENDPOINT est plus
# haut, avec les deux modes de lancement.
#
# Pour viser R2 depuis ce poste plutôt que le MinIO local : laisser KYB_ENDPOINT
# vide et renseigner R2_ACCOUNT_ID / KYB_ACCESS_KEY / KYB_SECRET_KEY.
#KYB_ACCESS_KEY=
#KYB_SECRET_KEY=
