# =====================================================================
#  PRODUCTION — variables d'environnement
#  Copier en .env.prod (gitignoré) et renseigner les vraies valeurs :
#     cp .env.prod.example .env.prod
#  Lancement :
#     docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# =====================================================================

# --- Domaine racine (les surfaces sont des sous-domaines) ---
# Doivent pointer (DNS A/AAAA) vers l'IP du serveur :
#   api.$ROOT_DOMAIN  m.$ROOT_DOMAIN  web.$ROOT_DOMAIN  seller.$ROOT_DOMAIN  admin.$ROOT_DOMAIN
ROOT_DOMAIN=example.com

# --- Let's Encrypt ---
ACME_EMAIL=admin@example.com

# --- Base de données -------------------------------------------------------
# La production utilise une base MANAGÉE EXTERNE (OVH Cloud Databases). Le service
# `postgres` a été RETIRÉ de docker-compose.prod.yml : les variables POSTGRES_DB,
# POSTGRES_USER et POSTGRES_PASSWORD ne servent plus à rien ici.
#
# Hôte, port, utilisateur et mot de passe se lisent dans la console OVH, onglets
# « Informations générales » et « Utilisateurs et droits ».
#
# ⚠️ « SSL Mode=Require » est imposé par OVH.
#
# ⚠️ « Maximum Pool Size » n'est PAS facultatif. Npgsql ouvre un pool par processus,
# plafonné à 100 par défaut ; cette pile en compte CINQ (api + 4 BFF), soit jusqu'à
# 500 connexions réclamées à une instance qui en autorise une fraction. Sous charge,
# on obtient des refus de connexion, pas un ralentissement. Ajuster selon le
# `max_connections` du plan souscrit — 10 par service est un point de départ prudent.
#
# ⚠️ L'IP publique du VPS doit figurer dans les « IPs autorisées » de la console
# OVH. Tout est bloqué par défaut, et l'échec ressemble à une base indisponible.
MARKETPLACE_CONNECTION=Host=rsXXXXXXX-001.eu.clouddb.ovh.net;Port=35292;Database=marketplace;Username=CHANGE_ME;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=10

# --- Redis (mot de passe fort) ---
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM

# --- JWT (identique pour l'API et les 4 BFF ; >= 32 octets) ---
# openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_LONG_RANDOM

# --- FedaPay (paiements ET versements) — clés LIVE en production ---
#
# L'URL et la clé DOIVENT désigner le même monde, sinon l'API refuse de démarrer.
#   live    : https://api.fedapay.com/v1         + sk_live_…
#   sandbox : https://sandbox-api.fedapay.com/v1 + sk_sandbox_…
FEDAPAY_BASE_URL=https://api.fedapay.com/v1
FEDAPAY_API_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Versements réels (retraits vendeur). IMPOSSIBLES en sandbox : FedaPay y répond
# « 403 Opération non autorisée ». Exigent, en plus de ce drapeau :
#   1. l'URL live ci-dessus + une clé sk_live_… ;
#   2. les DÉPÔTS activés sur le compte marchand par FedaPay (démarche à faire
#      auprès d'eux, ce n'est pas un réglage de notre côté) ;
#   3. un solde de dépôt approvisionné chez FedaPay.
# À false, les retraits sont simulés (ils aboutissent sans mouvement d'argent).
FEDAPAY_ENABLE_PAYOUTS=false

# --- Cloudflare R2 — identifiants S3 (partagés KYB + images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Cloudflare R2 — pièces KYB (bucket PRIVÉ) ---
R2_BUCKET_NAME=hbaexpress-documents-pdf
# Laisser VIDE (accès par URL présignée). Ne jamais rendre ce bucket public.
R2_PUBLIC_BASE_URL=

# --- Cloudflare R2 — images produit (bucket PUBLIC) ---
R2_MEDIA_BUCKET_NAME=habexpress-images
R2_MEDIA_KEY_PREFIX=products-images
# En prod, préférer un DOMAINE PERSONNALISÉ connecté au bucket (pas de limite r2.dev).
R2_MEDIA_PUBLIC_BASE_URL=https://images.hbamediacore.fr

# --- Cloudinary (traitement image : détourage IA + fond blanc) ---
# Depuis le Dashboard Cloudinary (Product Environment Credentials). Add-on
# "AI Background Removal" requis. Vide = pas de détourage (image inchangée).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS : origines autorisées à appeler les BFF depuis un navigateur ---
# UNIQUEMENT les origines réelles des consoles. Jamais localhost.
ADMIN_CORS_ORIGINS=
SELLER_CORS_ORIGINS=

# --- Validation des comptes -------------------------------------------------
# true  : toute inscription publique attend l'aval d'un administrateur (console
#         > Utilisateurs > « En attente »). Sûr, mais la file devient le goulot
#         d'étranglement dès que le volume monte.
# false : les acheteurs sont actifs immédiatement.
REQUIRE_APPROVAL_BUYERS=true
# Comptes créés DEPUIS la console admin : actifs d'emblée (vous venez de les créer).
REQUIRE_APPROVAL_ADMIN_CREATED=false

# ─────────────────────────────────────────────────────────────────────────────
# E-MAILS TRANSACTIONNELS (Resend) — OBLIGATOIRE EN PRODUCTION.
# L'API refuse de démarrer sans, et c'est voulu : sans e-mail, personne ne peut
# vérifier son adresse ni récupérer un mot de passe oublié.
# Le domaine de EMAIL_FROM doit être vérifié chez Resend (SPF + DKIM).
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# AMORÇAGE DU PREMIER ADMINISTRATEUR (bootstrap)
# Renseignés → l'API crée ce compte admin au 1er démarrage (rôle Admin, actif).
# IDEMPOTENT : ne réécrit jamais un compte existant, ne réinitialise pas le mot
# de passe. Laisser ADMIN_EMAIL/ADMIN_PASSWORD vides si tu crées l'admin autrement.
# Après la 1re connexion : change le mot de passe dans la console, puis tu peux
# retirer ADMIN_PASSWORD. Le mot de passe est un SECRET → vault en prod.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Plateforme
ADMIN_PHONE=+22900000000
