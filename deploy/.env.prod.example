# lui-même et la validation ACME de Traefik échoue.
SELLER_CONSOLE_DOMAIN=pro.hba-express.com

# --- Let's Encrypt ---
ACME_EMAIL=admin@example.com

POSTGRES_DB=HbaExpressDb
POSTGRES_USER=HbaExpressUser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MARKETPLACE_CONNECTION=Host=postgres;Port=5432;Database=HbaExpressDb;Username=HbaExpressUser;Password=CHANGE_ME_STRONG_DB_PASSWORD;Maximum Pool Size=15
#
# BASE EXTERNE MANAGÉE — variante, à n'adopter qu'en connaissance de cause.
#
# Le fournisseur doit accorder « CREATE ON DATABASE » à l'utilisateur applicatif.
# Cette application est un monolithe modulaire à UN SCHÉMA PAR MODULE : elle en crée
# 25 au premier démarrage. Les offres mutualisées (OVH Web Cloud Databases par
# exemple) ne le permettent pas — seul le rôle `postgres`, inaccessible au client,
# détient ce droit. La panne se manifeste par « 42501: permission denied for
# database », après que la connexion et l'authentification ont pourtant réussi.
# Vérifier AVANT de migrer :
#   SELECT has_database_privilege(current_user, current_database(), 'CREATE');
#
# Si l'offre convient, retirer le service `postgres` du compose, laisser POSTGRES_*
# vides et renseigner :
#   MARKETPLACE_CONNECTION=Host=…;Port=…;Database=…;Username=…;Password=…;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=10

# --- Redis : celui du VPS, ce dépôt n'en déploie plus ---
# REDIS_CONNECTION est normalement assemblée par Ansible. En déploiement manuel :
#   <nom-du-conteneur-redis>:6379,password=…,abortConnect=false
REDIS_CONNECTION=
# Réseau Docker partagé par lequel l'api joint ce Redis (déclaré en externe).
REDIS_NETWORK=
# Préfixe des clés — le Redis est partagé avec d'autres applications.
REDIS_INSTANCE_NAME=marketplace:

# --- Chiffrement des secrets des fournisseurs (console admin) ---
# Chiffre les clés d'API des PSP, de Resend, de Twilio… stockées en base.
# OBLIGATOIRE : sans elle, l'hôte refuse de démarrer en production.
#   openssl rand -base64 32
PLATFORM_SECRET_KEY=

# --- JWT (>= 32 octets) ---
# openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_LONG_RANDOM

# --- Session de la console d'administration (>= 32 caractères) ---
# Chiffre le cookie de session admin (AES-256-GCM). Vide ou trop court, la console
# refuse la connexion — et sans le garde applicatif, la session serait forgeable.
# Coller la SORTIE de la commande, pas la commande :
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM

# ── Console VENDEUR ($SELLER_CONSOLE_DOMAIN) ───────────────────────────────────────────
# Chiffre le cookie de session des vendeurs, qui contient leurs jetons d'accès et
# de rafraîchissement. Un secret faible ou d'exemple les rend FORGEABLES : n'importe
# qui pourrait alors ouvrir une session au nom de n'importe quel vendeur.
#
#   openssl rand -base64 32
#
# La console refuse de démarrer si ce secret est absent, fait moins de 32 caractères,
# est trop peu varié, ou ressemble à un exemple. Le compose échoue d'ailleurs avant,
# sur un `:?`.
SELLER_SESSION_SECRET=

# ── VITRINE ACHETEUR ($ROOT_DOMAIN) ───────────────────────────────────────────────────
# Chiffre le cookie de session des acheteurs, qui contient leurs jetons d'accès et de
# rafraîchissement. Ce compte porte l'adresse de livraison, l'historique des commandes,
# le portefeuille et les conversations avec les vendeurs : un secret faible les rend
# FORGEABLES.
#
#   openssl rand -base64 48
#
# La vitrine refuse de servir une session si ce secret est absent, fait moins de 32
# caractères, est trop peu varié, ou ressemble à un exemple. Le compose échoue d'ailleurs
# avant, sur un `:?`.
#
# NOTE : sur le VPS, ce fichier est RÉGÉNÉRÉ par Ansible à chaque déploiement, depuis
# `ansible/roles/marketplace/templates/env.j2`. La valeur se pose dans le vault
# (`client_session_secret`), pas ici.
CLIENT_SESSION_SECRET=

# --- FedaPay (paiements ET versements) — clés LIVE en production ---
#
# L'URL et la clé DOIVENT désigner le même monde, sinon l'API refuse de démarrer.
#   live    : https://api.fedapay.com/v1         + sk_live_…
#   sandbox : https://sandbox-api.fedapay.com/v1 + sk_sandbox_…
FEDAPAY_BASE_URL=https://api.fedapay.com/v1
FEDAPAY_API_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Versements réels (retraits vendeur). IMPOSSIBLES en sandbox : FedaPay y répond
# « 403 Opération non autorisée ». Exigent, en plus de ce drapeau :
#   1. l'URL live ci-dessus + une clé sk_live_… ;
#   2. les DÉPÔTS activés sur le compte marchand par FedaPay (démarche à faire
#      auprès d'eux, ce n'est pas un réglage de notre côté) ;
#   3. un solde de dépôt approvisionné chez FedaPay.
# À false, les retraits sont simulés (ils aboutissent sans mouvement d'argent).
FEDAPAY_ENABLE_PAYOUTS=false

# --- Cloudflare R2 — identifiants S3 (partagés KYB + images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Cloudflare R2 — pièces KYB (bucket PRIVÉ) ---
R2_BUCKET_NAME=hbaexpress-documents-pdf
# Laisser VIDE (accès par URL présignée). Ne jamais rendre ce bucket public.
R2_PUBLIC_BASE_URL=

# --- Cloudflare R2 — images produit (bucket PUBLIC) ---
R2_MEDIA_BUCKET_NAME=habexpress-images
R2_MEDIA_KEY_PREFIX=products-images
# En prod, préférer un DOMAINE PERSONNALISÉ connecté au bucket (pas de limite r2.dev).
R2_MEDIA_PUBLIC_BASE_URL=https://images.hbamediacore.fr

# --- Cloudinary (traitement image : détourage IA + fond blanc) ---
# Depuis le Dashboard Cloudinary (Product Environment Credentials). Add-on
# "AI Background Removal" requis. Vide = pas de détourage (image inchangée).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Détourage d'image (local, gratuit) ────────────────────────────────────────
# LAISSER REMBG_URL COMMENTÉE dans le cas courant : le compose pointe alors sur le
# service `rembg` du réseau interne.
#
# La DÉCOMMENTER en la laissant vide DÉSACTIVE la fonction (image inchangée, et les
# interfaces cessent de promettre un détourage) et fait retomber sur Cloudinary s'il
# est configuré. C'est le seul commutateur d'arrêt : la substitution du compose
# distingue « variable absente » de « variable vide ».
#
# IMPORTANT : NE PAS mettre un modèle BRIA (« bria-rmbg ») dans REMBG_MODEL : poids en
# CC BY-NC 4.0, usage commercial interdit. Seuls les modèles de la famille U²-Net
# sont acceptés par le code ; toute autre valeur retombe sur u2net.
#REMBG_URL=
REMBG_MODEL=u2net
# Ressources du conteneur. REMBG_THREADS borne les détourages SIMULTANÉS (et les
# threads ONNX) : sans lui, rembg en tenterait jusqu'à quarante de front.
REMBG_CPUS=2
REMBG_MEMORY=2G
REMBG_THREADS=2

# --- CORS : origines navigateur autorisées, UNE LISTE PAR SURFACE ---
# UNIQUEMENT les origines réelles. Jamais localhost en production. Une liste commune
# autoriserait la vitrine à appeler /api/admin : les trois surfaces partagent l'origine
# serveur de l'hôte.
CLIENT_CORS_ORIGINS=
SELLER_CORS_ORIGINS=
ADMIN_CORS_ORIGINS=

# --- Validation des comptes -------------------------------------------------
# true  : toute inscription publique attend l'aval d'un administrateur (console
#         > Utilisateurs > « En attente »). Sûr, mais la file devient le goulot
#         d'étranglement dès que le volume monte.
# false : les acheteurs sont actifs immédiatement.
REQUIRE_APPROVAL_BUYERS=true
# Comptes créés DEPUIS la console admin : actifs d'emblée (vous venez de les créer).
REQUIRE_APPROVAL_ADMIN_CREATED=false

# ─────────────────────────────────────────────────────────────────────────────
# E-MAILS TRANSACTIONNELS (Resend) — OBLIGATOIRE EN PRODUCTION.
# L'API refuse de démarrer sans, et c'est voulu : sans e-mail, personne ne peut
# vérifier son adresse ni récupérer un mot de passe oublié.
# Le domaine de EMAIL_FROM doit être vérifié chez Resend (SPF + DKIM).
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# AMORÇAGE DU PREMIER ADMINISTRATEUR (bootstrap)
# Renseignés → l'API crée ce compte admin au 1er démarrage (rôle Admin, actif).
# IDEMPOTENT : ne réécrit jamais un compte existant, ne réinitialise pas le mot
# de passe. Laisser ADMIN_EMAIL/ADMIN_PASSWORD vides si tu crées l'admin autrement.
# Après la 1re connexion : change le mot de passe dans la console, puis tu peux
# retirer ADMIN_PASSWORD. Le mot de passe est un SECRET → vault en prod.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Plateforme
ADMIN_PHONE=+22900000000
