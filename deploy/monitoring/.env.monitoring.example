# Copier en .env (dans ce dossier) et adapter.
# Identifiants Grafana (à changer impérativement).
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-please

# Domaine public de Grafana (route Traefik + certificat Let's Encrypt).
GRAFANA_HOST=grafana.hba-marketplace.fr

# Réseau Docker EXTERNE partagé avec la stack app + Traefik.
#   staging : marketplace-staging-net   |   prod : marketplace-net
APP_NETWORK=marketplace-staging-net
