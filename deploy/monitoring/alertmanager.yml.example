# EXEMPLE — le vrai alertmanager.yml est GÉNÉRÉ par Ansible (depuis le vault) sur
# l'hôte, et exclu de la synchro Git (il contient des secrets). Ce fichier documente
# le format attendu. Routage : critical → Slack + e-mail ; warning → Slack.
global:
  resolve_timeout: 5m
  smtp_smarthost: "smtp.example.com:587"
  smtp_from: "alertmanager@hba-marketplace.fr"
  smtp_auth_username: "USER"
  smtp_auth_password: "CHANGE_ME"        # → vault : smtp_password
  smtp_require_tls: true

route:
  receiver: default
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: [ 'severity="critical"' ]
      receiver: critical
      repeat_interval: 1h
    - matchers: [ 'severity="warning"' ]
      receiver: warning

receivers:
  - name: default
    slack_configs:
      - api_url: "https://hooks.slack.com/services/XXX/YYY/ZZZ"   # → vault : alertmanager_slack_webhook_url
        channel: "#alerts"
        send_resolved: true

  - name: critical
    slack_configs:
      - api_url: "https://hooks.slack.com/services/XXX/YYY/ZZZ"
        channel: "#alerts"
        send_resolved: true
    email_configs:
      - to: "ops@hba-marketplace.fr"                              # → group_vars : alert_email_to
        send_resolved: true

  - name: warning
    slack_configs:
      - api_url: "https://hooks.slack.com/services/XXX/YYY/ZZZ"
        channel: "#alerts"
        send_resolved: true
