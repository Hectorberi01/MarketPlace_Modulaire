# Généré par Ansible — middleware de garde de l'admin base de données (pgweb).
# dbadmin-guard = liste blanche d'IP + auth HTTP + en-têtes (embarquement iframe).
#
# IMPORTANT : DENY-BY-DEFAULT : si db_admin_allowed_ips OU db_admin_basic_auth_users est
# vide, Traefik refuse toutes les requêtes. L'admin BD reste donc INACCESSIBLE
# tant que les deux ne sont pas renseignés dans le vault.
http:
  middlewares:
    dbadmin-ipallow:
      ipAllowList:
        sourceRange:
{% for ip in db_admin_allowed_ips | default([]) %}
          - "{{ ip }}"
{% endfor %}

    dbadmin-auth:
      basicAuth:
        users:
{% for u in db_admin_basic_auth_users | default([]) %}
          - "{{ u }}"
{% endfor %}

    # Retire X-Frame-Options pour permettre l'embarquement en iframe DANS la
    # console (sous-domaine différent).
    dbadmin-headers:
      headers:
        contentTypeNosniff: true
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Frame-Options: ""
          Server: ""

    dbadmin-guard:
      chain:
        middlewares:
          - dbadmin-ipallow
          - dbadmin-auth
          - dbadmin-headers
