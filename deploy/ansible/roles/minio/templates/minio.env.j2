# Généré par Ansible (rôle minio) — NE PAS ÉDITER À LA MAIN.

# Identifiants RACINE. Ce sont ceux de l'administrateur du service : l'application,
# elle, utilise un compte dédié (voir le runbook). Les confondre reviendrait à
# donner à un processus web le droit d'effacer le bucket.
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# ── ADRESSES D'ÉCOUTE ───────────────────────────────────────────────────────────
#
# L'API sur la seule adresse du tunnel : il n'existe aucun socket qu'Internet
# puisse atteindre, même si le pare-feu tombait. La console sur la boucle locale :
# on y accède par un tunnel SSH, jamais en la publiant.
MINIO_ADDRESS={{ wg_db_ip }}:{{ minio_api_port }}
MINIO_CONSOLE_ADDRESS={{ minio_console_bind }}:{{ minio_console_port }}

# La région doit être la MÊME que celle avec laquelle l'application signe
# (S3StorageOptions.Region). Une divergence donne « SignatureDoesNotMatch », sans
# indiquer que c'est la région qui est en cause.
MINIO_REGION={{ minio_region | default('us-east-1') }}

# Pas de télémétrie sortante depuis la machine qui garde les documents de conformité.
MINIO_UPDATE=off
