# Généré par Ansible — middleware de garde du terminal web.
# terminal-guard = liste blanche d'IP + auth HTTP + en-têtes (embarquement iframe).
#
# ⚠️ DENY-BY-DEFAULT : si terminal_allowed_ips OU terminal_basic_auth_users est
# vide, Traefik refuse toutes les requêtes. Le terminal reste donc INACCESSIBLE
# tant que les deux ne sont pas renseignés dans le vault.
http:
  middlewares:
    terminal-ipallow:
      ipAllowList:
        sourceRange:
{% for ip in terminal_allowed_ips | default([]) %}
          - "{{ ip }}"
{% endfor %}

    terminal-auth:
      basicAuth:
        users:
{% for u in terminal_basic_auth_users | default([]) %}
          - "{{ u }}"
{% endfor %}

    # Retire X-Frame-Options (wetty l'envoie en SAMEORIGIN) pour permettre
    # l'embarquement en iframe DANS la console (sous-domaine différent).
    # customResponseHeaders à "" = suppression de l'en-tête.
    terminal-headers:
      headers:
        contentTypeNosniff: true
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Frame-Options: ""
          Server: ""

    terminal-guard:
      chain:
        middlewares:
          - terminal-ipallow
          - terminal-auth
          - terminal-headers
