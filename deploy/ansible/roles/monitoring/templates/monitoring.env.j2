GRAFANA_USER={{ grafana_admin_user | default('admin') }}
GRAFANA_PASSWORD={{ grafana_password }}
GRAFANA_HOST={{ grafana_host | default('grafana.hba-marketplace.fr') }}
# Réseau Docker EXTERNE partagé avec la stack app + Traefik.
APP_NETWORK={{ app_network | default(traefik_network) }}
# Mot de passe Redis (secret vault) — utilisé par redis-exporter pour se connecter.
REDIS_PASSWORD={{ redis_password }}
