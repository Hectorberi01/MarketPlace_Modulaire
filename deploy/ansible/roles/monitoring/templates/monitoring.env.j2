# ---------------------------------------------------------------------
# Généré par Ansible pour la stack monitoring de « {{ target_env }} ».
# NE PAS éditer à la main — modifier group_vars / vault et relancer.
# ---------------------------------------------------------------------
GRAFANA_USER={{ grafana_admin_user | default('admin') }}
GRAFANA_PASSWORD={{ grafana_password }}
GRAFANA_HOST={{ grafana_host | default('grafana.hba-marketplace.fr') }}
# Réseau Docker EXTERNE partagé avec la stack app + Traefik.
APP_NETWORK={{ app_network | default(traefik_network) }}
# Mot de passe Redis (secret vault) — utilisé par redis-exporter pour se connecter.
REDIS_PASSWORD={{ redis_password }}
{% if postgres_password is defined %}
# DSN PostgreSQL pour postgres-exporter (base CO-HÉBERGÉE, service `postgres`).
# sslmode=disable : réseau Docker interne, pas de TLS. Absent si base externe (Neon).
#
# ⚠️ Format clé=valeur (libpq), PAS URL : un mot de passe contenant % ou & casse le
# parseur d'URL (« invalid URL escape »). En clé=valeur, ces caractères sont
# littéraux (seuls l'espace et l'apostrophe demanderaient un quotage — évités ici).
POSTGRES_EXPORTER_DSN=host=postgres port=5432 user={{ postgres_user | default('postgres') }} password={{ postgres_password }} dbname={{ postgres_db | default('marketplace') }} sslmode=disable
{% endif %}
