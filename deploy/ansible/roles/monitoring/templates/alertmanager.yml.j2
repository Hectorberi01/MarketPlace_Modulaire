# ---------------------------------------------------------------------
# GÉNÉRÉ par Ansible pour Alertmanager ({{ target_env }}) — NE PAS éditer à la main.
# Secrets (webhook Slack, mot de passe SMTP) proviennent du vault.
# Routage : Watchdog → battement de cœur ; critical → Slack + e-mail ;
# warning → Slack (ou e-mail si pas de Slack).
#
# `alert_slack_actif` et `alert_email_actif` sont calculés par le rôle : ils valent
# faux quand la valeur manque OU qu'elle est encore un gabarit (« CHANGE_ME »). Un
# canal à moitié configuré rendrait un receiver qui accepte les notifications et
# échoue à l'envoi, ce qui est plus trompeur qu'un canal absent.
# ---------------------------------------------------------------------
global:
  resolve_timeout: 5m
{% if alert_email_actif %}
  smtp_smarthost: "{{ smtp_host }}:{{ smtp_port | default(587) }}"
  smtp_from: "{{ smtp_from | default('alertmanager@hba-marketplace.fr') }}"
  smtp_auth_username: "{{ smtp_username | default('') }}"
  smtp_auth_password: "{{ smtp_password | default('') }}"
  smtp_require_tls: true
{% endif %}

route:
  receiver: default
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # ─────────────────────────────────────────────────────────────────────────
    # SONDE DE VIE, EN PREMIER : LE SILENCE DOIT ÊTRE DÉTECTABLE.
    #
    # Alertmanager retient la PREMIÈRE route qui correspond. `Watchdog` est une
    # alerte toujours active : elle ne dit rien sur l'application, elle prouve que
    # la chaîne Prometheus → Alertmanager → notification fonctionne encore.
    #
    # Sans elle, une pile d'alerte morte et une production en parfaite santé
    # produisent exactement le même signal : rien. `alert_heartbeat_url` pointe
    # vers un service qui, lui, prévient quand les battements CESSENT
    # (healthchecks.io, Better Stack, cron-monitor…). Vide, la sonde ne part
    # nulle part et n'encombre personne.
    # ─────────────────────────────────────────────────────────────────────────
    - matchers:
        - 'alertname="Watchdog"'
      receiver: heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    - matchers:
        - 'severity="critical"'
      receiver: critical
      repeat_interval: 1h
    - matchers:
        - 'severity="warning"'
      receiver: warning

receivers:
  # Destinataire de la sonde de vie. Un receiver sans configuration est accepté par
  # Alertmanager et jette la notification : c'est exactement ce qu'on veut tant que
  # `alert_heartbeat_url` n'est pas renseignée — la sonde existe, elle ne sonne pas.
  - name: heartbeat
{% if alert_heartbeat_url is defined and alert_heartbeat_url %}
    webhook_configs:
      - url: "{{ alert_heartbeat_url }}"
        send_resolved: false
{% endif %}

  - name: default
{% if alert_slack_actif %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alert_slack_channel | default('#alerts') }}"
        send_resolved: true
        title: {% raw %}'{{ .CommonLabels.severity | toUpper }} — {{ .CommonLabels.alertname }}'{% endraw %}

        text: {% raw %}>-
          {{ range .Alerts }}*{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}{% endraw %}

{% elif alert_email_actif %}
{#- Sans ce repli, une alerte sans étiquette `severity` — donc sans route dédiée —
    tombait dans un receiver `default` vide et disparaissait, alors même qu'un canal
    e-mail parfaitement fonctionnel existait. #}
    email_configs:
      - to: "{{ alert_email_to }}"
        send_resolved: true
        headers:
          subject: {% raw %}'[ALERTE] {{ .CommonLabels.alertname }}'{% endraw %}

        html: {% raw %}>-
          {{ range .Alerts }}<h3>{{ .Annotations.summary }}</h3>
          <p>{{ .Annotations.description }}</p>{{ end }}{% endraw %}

{% endif %}

  - name: critical
{% if alert_slack_actif %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alert_slack_channel | default('#alerts') }}"
        send_resolved: true
        title: {% raw %}'🔴 {{ .CommonLabels.alertname }}'{% endraw %}

        text: {% raw %}>-
          {{ range .Alerts }}*{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}{% endraw %}

{% endif %}
{% if alert_email_actif %}
    email_configs:
      - to: "{{ alert_email_to }}"
        send_resolved: true
        headers:
          subject: {% raw %}'[CRITICAL] {{ .CommonLabels.alertname }}'{% endraw %}

        html: {% raw %}>-
          {{ range .Alerts }}<h3>{{ .Annotations.summary }}</h3>
          <p>{{ .Annotations.description }}</p>{{ end }}{% endraw %}

{% endif %}

  - name: warning
{% if alert_slack_actif %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alert_slack_channel | default('#alerts') }}"
        send_resolved: true
        title: {% raw %}'🟠 {{ .CommonLabels.alertname }}'{% endraw %}

        text: {% raw %}>-
          {{ range .Alerts }}*{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}{% endraw %}

{% elif alert_email_actif %}
    email_configs:
      - to: "{{ alert_email_to }}"
        send_resolved: true
        headers:
          subject: {% raw %}'[WARNING] {{ .CommonLabels.alertname }}'{% endraw %}

{% endif %}

# ═══════════════════════════════════════════════════════════════════════════════
# INHIBITIONS : UNE PANNE, UN MESSAGE.
#
# Un disque plein déclenche HostDiskWarning PUIS HostDiskCritical ; un exportateur
# mort rend toutes les métriques de l'hôte introuvables. Sans ces règles, une seule
# cause produit une rafale de notifications, et la rafale est ce qui pousse à couper
# le canal — c'est ainsi qu'une supervision meurt.
# ═══════════════════════════════════════════════════════════════════════════════
#
# PAS de règle « critical éteint warning » sur `equal: [alertname, ...]` : une règle
# d'alerte porte UNE sévérité, donc les deux côtés n'ont jamais le même `alertname`
# et la règle ne s'appliquerait jamais. On nomme les paires réelles.
inhibit_rules:
  # Disque : le seuil critique remplace le seuil d'avertissement.
  - source_matchers: ['alertname="HostDiskCritical"']
    target_matchers: ['alertname="HostDiskWarning"']
    equal: ["instance", "mountpoint"]

  # Exportateur d'hôte muet : ses métriques ne veulent plus rien dire, inutile de
  # notifier séparément chaque seuil qu'elles ne franchissent plus.
  - source_matchers: ['alertname="NodeExporterDown"']
    target_matchers: ['alertname=~"HostHighCpu|HostHighMemory|HostDiskWarning|HostDiskCritical"']
    equal: ["instance"]
