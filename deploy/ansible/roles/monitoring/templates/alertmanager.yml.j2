# ---------------------------------------------------------------------
# GÉNÉRÉ par Ansible pour Alertmanager ({{ target_env }}) — NE PAS éditer à la main.
# Secrets (webhook Slack, mot de passe SMTP) proviennent du vault.
# Routage : critical → Slack + e-mail ; warning → Slack (ou e-mail si pas de Slack).
# ---------------------------------------------------------------------
global:
  resolve_timeout: 5m
{% if smtp_host is defined and smtp_host %}
  smtp_smarthost: "{{ smtp_host }}:{{ smtp_port | default(587) }}"
  smtp_from: "{{ smtp_from | default('alertmanager@hba-marketplace.fr') }}"
  smtp_auth_username: "{{ smtp_username | default('') }}"
  smtp_auth_password: "{{ smtp_password | default('') }}"
  smtp_require_tls: true
{% endif %}

route:
  receiver: default
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - 'severity="critical"'
      receiver: critical
      repeat_interval: 1h
    - matchers:
        - 'severity="warning"'
      receiver: warning

receivers:
  - name: default
{% if alertmanager_slack_webhook_url is defined and alertmanager_slack_webhook_url %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alert_slack_channel | default('#alerts') }}"
        send_resolved: true
        title: {% raw %}'{{ .CommonLabels.severity | toUpper }} — {{ .CommonLabels.alertname }}'{% endraw %}

        text: {% raw %}>-
          {{ range .Alerts }}*{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}{% endraw %}

{% endif %}

  - name: critical
{% if alertmanager_slack_webhook_url is defined and alertmanager_slack_webhook_url %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alert_slack_channel | default('#alerts') }}"
        send_resolved: true
        title: {% raw %}'🔴 {{ .CommonLabels.alertname }}'{% endraw %}

        text: {% raw %}>-
          {{ range .Alerts }}*{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}{% endraw %}

{% endif %}
{% if smtp_host is defined and smtp_host and alert_email_to is defined and alert_email_to %}
    email_configs:
      - to: "{{ alert_email_to }}"
        send_resolved: true
        headers:
          subject: {% raw %}'[CRITICAL] {{ .CommonLabels.alertname }}'{% endraw %}

        html: {% raw %}>-
          {{ range .Alerts }}<h3>{{ .Annotations.summary }}</h3>
          <p>{{ .Annotations.description }}</p>{{ end }}{% endraw %}

{% endif %}

  - name: warning
{% if alertmanager_slack_webhook_url is defined and alertmanager_slack_webhook_url %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alert_slack_channel | default('#alerts') }}"
        send_resolved: true
        title: {% raw %}'🟠 {{ .CommonLabels.alertname }}'{% endraw %}

        text: {% raw %}>-
          {{ range .Alerts }}*{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}{% endraw %}

{% elif smtp_host is defined and smtp_host and alert_email_to is defined and alert_email_to %}
    email_configs:
      - to: "{{ alert_email_to }}"
        send_resolved: true
        headers:
          subject: {% raw %}'[WARNING] {{ .CommonLabels.alertname }}'{% endraw %}

{% endif %}
