# Généré par Ansible (rôle backup) — NE PAS ÉDITER À LA MAIN.
BACKUP_DIR={{ backup_dir }}
LOCAL_RETENTION_DAYS={{ backup_retention_days }}
BACKUP_BUCKET={{ backup_bucket }}
BACKUP_PREFIX={{ backup_prefix }}
PG_USER=postgres
PG_DATABASES="{{ backup_databases }}"
MAX_AGE_HOURS={{ backup_max_age_hours }}

# Cloudflare R2. Le script REFUSE de considérer une sauvegarde comme faite si elle
# n'a pas quitté la machine : un dump qui reste sur le serveur qu'il sauvegarde ne
# protège ni de la perte du VPS, ni du chiffrement du disque, ni d'un rm malheureux.
R2_ACCOUNT_ID={{ r2_account_id | default('') }}
R2_ACCESS_KEY_ID={{ r2_backup_access_key_id | default(r2_access_key_id) | default('') }}
R2_SECRET_ACCESS_KEY={{ r2_backup_secret_access_key | default(r2_secret_access_key) | default('') }}
