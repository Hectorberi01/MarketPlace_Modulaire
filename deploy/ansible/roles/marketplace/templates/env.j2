# ---------------------------------------------------------------------
# Fichier généré par Ansible pour l'environnement « {{ target_env }} ».
# NE PAS éditer à la main — modifier les group_vars / le vault et relancer.
# ---------------------------------------------------------------------

{% if postgres_password is defined and not (use_external_database | default(false)) %}
# --- Postgres CO-HÉBERGÉ (service `postgres` du compose) ---
# Ces trois variables initialisent le CONTENEUR. Elles n'ont plus de sens dès que la
# base vit sur une autre machine : les écrire quand même laisserait croire qu'un
# Postgres local est encore attendu, et le compose en démarrerait un.
POSTGRES_DB={{ postgres_db | default('marketplace') }}
POSTGRES_USER={{ postgres_user | default('postgres') }}
POSTGRES_PASSWORD={{ postgres_password }}
{% endif %}
# --- Chaîne de connexion (format Npgsql) ---
{% if marketplace_connection is defined %}
# Chaîne fournie EXPLICITEMENT dans le vault. Prioritaire sur tout le reste : c'est
# la porte de sortie quand la base n'est ni le conteneur local ni le VPS dédié.
MARKETPLACE_CONNECTION={{ marketplace_connection }}
{% elif use_external_database | default(false) %}
# Base sur le VPS DÉDIÉ, jointe par le tunnel WireGuard. Voir
# `marketplace_connection_external` et le drapeau `use_external_database`.
MARKETPLACE_CONNECTION={{ marketplace_connection_external }}
{% elif postgres_password is defined %}
# Base LOCALE : le service `postgres` du compose, sur le réseau Docker interne.
MARKETPLACE_CONNECTION=Host=postgres;Port=5432;Database={{ postgres_db | default('marketplace') }};Username={{ postgres_user | default('postgres') }};Password={{ postgres_password }};Maximum Pool Size={{ npgsql_max_pool_size | default(15) }}
{% endif %}

# ═══════════════════════════════════════════════════════════════════════════════
# CE QUI DÉCIDE QUE LE COMPOSE DÉMARRE, OU NON, UN POSTGRES LOCAL.
#
# Lue par le profil `local-db` du compose de production. Vide = pas de conteneur
# Postgres. C'est la seule chose qui empêche, après la bascule, qu'une base vide
# tourne à côté de la vraie et attende qu'une erreur de configuration l'y renvoie.
# ═══════════════════════════════════════════════════════════════════════════════
COMPOSE_PROFILES={{ '' if (use_external_database | default(false)) else 'local-db' }}

{% if image_prefix is defined %}
# --- Images (registry) ---
IMAGE_PREFIX={{ image_prefix }}
IMAGE_TAG={{ image_tag | default('staging') }}
{% endif %}

# --- JWT ---
JWT_SIGNING_KEY={{ jwt_signing_key }}
{% if redis_password is defined %}
REDIS_PASSWORD={{ redis_password }}
{% endif %}
{% if root_domain is defined %}

# --- Edge / TLS ---
ROOT_DOMAIN={{ root_domain }}
ACME_EMAIL={{ acme_email }}
{% if acme_caserver is defined %}
ACME_CASERVER={{ acme_caserver }}
{% endif %}
{% if traefik_http_port is defined %}
TRAEFIK_HTTP_PORT={{ traefik_http_port }}
TRAEFIK_HTTPS_PORT={{ traefik_https_port }}
{% endif %}
{% endif %}

# --- FedaPay ---
{# Le défaut sandbox ne vaut QUE pour la recette : en production, `docker compose`
   exige désormais cette variable (`:?`), donc un vault incomplet fera échouer le
   déploiement au lieu de brancher la production sur le bac à sable. #}
FEDAPAY_BASE_URL={{ fedapay_base_url | default('https://sandbox-api.fedapay.com/v1' if target_env != 'prod' else '') }}
FEDAPAY_API_KEY={{ fedapay_api_key | default('') }}
FEDAPAY_WEBHOOK_SECRET={{ fedapay_webhook_secret | default('') }}
FEDAPAY_ENABLE_PAYOUTS={{ fedapay_enable_payouts | default('false') }}

# --- Cloudflare R2 (identifiants S3) ---
R2_ACCOUNT_ID={{ r2_account_id | default('') }}
R2_ACCESS_KEY_ID={{ r2_access_key_id | default('') }}
R2_SECRET_ACCESS_KEY={{ r2_secret_access_key | default('') }}

# --- R2 KYB (privé) ---
R2_BUCKET_NAME={{ r2_bucket_name | default('') }}
R2_PUBLIC_BASE_URL={{ r2_public_base_url | default('') }}

# --- R2 images produit (public) ---
R2_MEDIA_BUCKET_NAME={{ r2_media_bucket_name | default('') }}
R2_MEDIA_KEY_PREFIX={{ r2_media_key_prefix | default('') }}
R2_MEDIA_PUBLIC_BASE_URL={{ r2_media_public_base_url | default('') }}

# --- Cloudinary (traitement image : détourage IA + fond blanc) ---
CLOUDINARY_CLOUD_NAME={{ cloudinary_cloud_name | default('') }}
CLOUDINARY_API_KEY={{ cloudinary_api_key | default('') }}
CLOUDINARY_API_SECRET={{ cloudinary_api_secret | default('') }}

# Détourage d'image local (rembg).
#
# La ligne REMBG_URL n'est écrite QUE si `rembg_url` est défini dans l'inventaire.
# Rendre systématiquement « REMBG_URL= » désactiverait la fonction sur toutes les
# machines : le compose distingue « absente » (valeur par défaut http://rembg:7000)
# de « présente mais vide » (fonction coupée). C'est tout l'intérêt de la
# substitution sans deux-points côté compose — la neutraliser ici la viderait de son
# sens.
#
# Ne jamais renseigner un modèle BRIA : licence non commerciale.
{% if rembg_url is defined %}REMBG_URL={{ rembg_url }}
{% endif %}
REMBG_MODEL={{ rembg_model | default('u2net') }}
REMBG_CPUS={{ rembg_cpus | default('2') }}
REMBG_MEMORY={{ rembg_memory | default('2G') }}
REMBG_THREADS={{ rembg_threads | default('2') }}

# --- Observabilité / Monitoring (voir deploy/monitoring/) ---
# Vides = désactivé (aucun export, KPIs/embed masqués).
OTEL_ENDPOINT={{ otel_endpoint | default('') }}
PROMETHEUS_URL={{ prometheus_url | default('') }}
# URL interne de Loki (API HTTP) pour le panneau « Logs » de la console. Vide = masqué.
LOKI_URL={{ loki_url | default('') }}
GRAFANA_URL={{ grafana_url | default('') }}
GRAFANA_EMBED_URL={{ grafana_embed_url | default('') }}
# Guillemets obligatoires : l'URL contient un « # » (fragment /#!/auth) que Docker
# Compose interpréterait sinon comme un début de commentaire.
PORTAINER_URL="{{ portainer_url | default('') }}"

# CORS — origines navigateur autorisées sur les BFF (liste séparée par des virgules).
# Sans elles, la console d'administration est bloquée par le navigateur.
ADMIN_CORS_ORIGINS={{ admin_cors_origins | default('https://admin.' ~ root_domain) }}
SELLER_CORS_ORIGINS={{ seller_cors_origins | default('') }}

# --- Validation des comptes -------------------------------------------------
# true  : toute inscription publique attend l'aval d'un administrateur (console
#         > Utilisateurs > « En attente »). Sûr, mais la file devient le goulot
#         d'étranglement dès que le volume monte.
# false : les acheteurs sont actifs immédiatement.
REQUIRE_APPROVAL_BUYERS=true
# Comptes créés DEPUIS la console admin : actifs d'emblée (vous venez de les créer).
REQUIRE_APPROVAL_ADMIN_CREATED=false

# --- E-mails transactionnels (Resend) — OBLIGATOIRE en production ---
# Sans eux, l'API REFUSE de démarrer en Production (vérification e-mail + reset).
# resend_api_key -> vault ; email_from / email_app_base_url -> group_vars.
RESEND_API_KEY={{ resend_api_key | default('') }}
EMAIL_FROM={{ email_from | default('') }}
EMAIL_APP_BASE_URL={{ email_app_base_url | default('') }}

# --- Console d'administration (Next) : secret de chiffrement du cookie de session ---
# Généré par : openssl rand -base64 32. -> vault (admin_session_secret).
# Vide = la console démarre avec un secret de dev peu sûr : à renseigner en staging/prod.
ADMIN_SESSION_SECRET={{ admin_session_secret | default('') }}

# Console vendeur (pro.<domaine>). Vient du vault, comme son homologue admin.
# Laissé vide, le compose ÉCHOUE au déploiement — c'est voulu : mieux vaut un
# déploiement qui s'arrête qu'une console dont les sessions sont forgeables.
SELLER_SESSION_SECRET={{ seller_session_secret | default('') }}

# Vitrine acheteur (le domaine racine). Vient du vault, comme ses deux homologues.
# Laissé vide, le compose ÉCHOUE au déploiement — c'est voulu : ce secret chiffre les
# jetons d'un compte qui porte l'adresse de livraison, l'historique et le portefeuille.
#
# DISTINCT des deux autres. Depuis que la surface entre dans le sceau de la session, un
# secret partagé n'est plus rejouable d'une surface à l'autre ; mais rien ne justifie de
# le partager.
CLIENT_SESSION_SECRET={{ client_session_secret | default('') }}

# Noms d'hôte COMPLETS des surfaces web publiques, sur une racine qui n'est pas
# `root_domain`. Le défaut retombe sur la racine pour que staging, qui n'a qu'un seul
# domaine, continue de fonctionner sans rien déclarer.
SITE_DOMAIN={{ site_domain | default(root_domain) }}
SITE_DOMAIN_APEX={{ site_domain_apex | default(root_domain) }}
ADMIN_CONSOLE_DOMAIN={{ admin_console_domain | default('console.' ~ root_domain) }}

# Nom d'hôte COMPLET de la console vendeur.
#
# TOUJOURS RENSEIGNÉ, jamais laissé vide — même quand la valeur est celle qu'on
# aurait devinée. Le compose porte bien un défaut `${SELLER_CONSOLE_DOMAIN:-pro.${ROOT_DOMAIN}}`,
# mais il repose sur une substitution IMBRIQUÉE dans la valeur par défaut, que les
# vieilles versions de Docker Compose n'étendent pas. Non étendue, la règle Traefik
# devient `Host(`pro.${ROOT_DOMAIN}`)` — un nom littéral, avec les accolades — et la
# console répond 404 sans qu'aucun conteneur ne signale d'erreur.
#
# En prod la valeur vient du group_vars (`pro.hba-express.com`, sur une AUTRE racine
# que root_domain). Ailleurs, on retombe explicitement sur `pro.<root_domain>`.
SELLER_CONSOLE_DOMAIN={{ seller_console_domain | default('pro.' ~ root_domain, true) }}

# --- Amorçage du premier administrateur (idempotent) ---
# Renseigner admin_email (group_vars) + admin_password (vault) pour créer l'admin
# au 1er démarrage de l'API. Vide = pas d'amorçage. Ne réinitialise jamais un
# compte existant.
ADMIN_EMAIL={{ admin_email | default('') }}
ADMIN_PASSWORD={{ admin_password | default('') }}
ADMIN_FIRST_NAME={{ admin_first_name | default('Admin') }}
ADMIN_LAST_NAME={{ admin_last_name | default('Plateforme') }}
ADMIN_PHONE={{ admin_phone | default('+22900000000') }}

# ═══════════════════════════════════════════════════════════════════════════════
# LE SERVICE DE DISPATCH — CINQ VARIABLES QUI MANQUAIENT À CE GABARIT.
#
# Le compose de production les exige avec la syntaxe `${X:?}`, qui fait ÉCHOUER
# l'interpolation. Or Compose interpole tout le fichier avant de créer quoi que ce
# soit : leur absence n'empêchait pas seulement le dispatch de démarrer, elle
# arrêtait `pull` et `up` pour LA PILE ENTIÈRE.
#
# Elles étaient documentées dans le gabarit de DÉVELOPPEMENT, et nulle part ici.
# ═══════════════════════════════════════════════════════════════════════════════

# Base du dispatch. SÉPARÉE de celle de la marketplace, et c'est une décision
# d'architecture, pas un détail : ce service réécrit des positions à la seconde,
# la marketplace tient de l'argent. Sur le VPS base dédié, c'est une seconde base
# du même cluster — même moteur, mais des WAL et un plan de reprise distincts de
# ceux d'un serveur partagé avec l'applicatif.
# Nom de la base, émis À PART : le compose s'en sert pour CRÉER la base, la chaîne
# ci-dessous pour s'y CONNECTER. Deux littéraux auraient fini par diverger, et le
# symptôme aurait été le même qu'aujourd'hui — un conteneur qui s'arrête au démarrage.
DISPATCH_DB={{ dispatch_db | default('dispatch') }}
{% if dispatch_connection is defined %}
DISPATCH_CONNECTION={{ dispatch_connection }}
{% elif use_external_database | default(false) %}
DISPATCH_CONNECTION=Host={{ wg_db_ip }};Port=5432;Database={{ dispatch_db | default('dispatch') }};Username={{ postgres_user }};Password={{ postgres_password }};Maximum Pool Size={{ npgsql_max_pool_size | default(15) }}
{% else %}
DISPATCH_CONNECTION=Host=postgres-dispatch;Port=5432;Database={{ dispatch_db | default('dispatch') }};Username={{ postgres_user | default('postgres') }};Password={{ postgres_password }};Maximum Pool Size={{ npgsql_max_pool_size | default(15) }}
{% endif %}

# Secrets CROISÉS entre la marketplace et le dispatch. Ce que l'un ENVOIE doit
# valoir ce que l'autre ATTEND : les intervertir donne deux services qui démarrent
# normalement et dont aucun appel ne passe.
#
# EXIGÉES EN PRODUCTION, TOLÉRÉES AILLEURS. Sans cette distinction, dev et staging
# — dont les inventaires ne portent pas ces secrets — deviendraient non déployables
# du jour au lendemain, et le message ne parlerait que du dispatch.
{% if target_env == 'prod' %}
DELIVERY_WEBHOOK_SECRET={{ delivery_webhook_secret }}
DISPATCH_OUTBOUND_SECRET={{ dispatch_outbound_secret }}
{% else %}
DELIVERY_WEBHOOK_SECRET={{ delivery_webhook_secret | default('') }}
DISPATCH_OUTBOUND_SECRET={{ dispatch_outbound_secret | default('') }}
{% endif %}

# Part des frais de livraison versée au coursier (0.80 = 80 %). AUCUN DÉFAUT DANS
# LE CODE : le service refuse de démarrer sans elle, parce que c'est une décision
# commerciale et qu'une valeur devinée se traduirait en argent mal réparti.
DISPATCH_COURIER_SHARE={{ dispatch_courier_share if target_env == 'prod' else (dispatch_courier_share | default('0.80')) }}

{% if dispatch_redis_connection is defined %}
DISPATCH_REDIS_CONNECTION={{ dispatch_redis_connection }}
{% endif %}

# ═══════════════════════════════════════════════════════════════════════════════
# PLAFOND DE VERSEMENT COURSIER.
#
# C'est la seule route qui fait sortir de l'argent du portefeuille de la plateforme
# vers celui d'un coursier. Le code ne vérifie le plafond que si la valeur est
# renseignée : vide, il n'y a AUCUNE limite, et la signature HMAC reste la seule
# barrière. Une valeur explicite est une seconde ligne de défense qui coûte un
# caractère.
# ═══════════════════════════════════════════════════════════════════════════════
COURIER_PAY_MAX_AMOUNT={{ courier_pay_max_amount | default(200000) }}

# --- Origines CORS des surfaces web (repli FERMÉ si vide) ---
{% if client_web_origins is defined %}
CLIENT_WEB_ORIGINS={{ client_web_origins }}
{% endif %}
{% if driver_console_origins is defined %}
DRIVER_CONSOLE_ORIGINS={{ driver_console_origins }}
{% endif %}

# --- Adresses internes (jamais par Traefik : la surface publique de l'API ne
#     route que les rappels des PSP) ---
MARKETPLACE_BASE_URL={{ marketplace_base_url | default('http://api:8080') }}
DISPATCH_BASE_URL={{ dispatch_base_url | default('http://dispatch:8080') }}

# ═══════════════════════════════════════════════════════════════════════════════
# STOCKAGE DES PIÈCES KYB — R2 OU MINIO, SELON UN SEUL DRAPEAU.
#
# Section « Storage:KybStorage », qui ne nomme plus un fournisseur. L'ancienne
# « Storage:CloudflareR2 » reste lue en repli par l'installeur, le temps que tous
# les environnements aient migré : la retirer d'un coup aurait fait basculer la
# production sur le stub hors-ligne, c'est-à-dire des pièces KYB acceptées et
# jamais stockées, sans la moindre erreur.
#
# POURQUOI CE STOCKAGE-LÀ PEUT QUITTER LE NUAGE, ET PAS LES IMAGES PRODUIT.
# Les pièces KYB sont des documents d'identité, de faible volume, jamais servis
# publiquement, lus par des URL présignées de cinq minutes. Les images produit sont
# servies à chaque affichage de fiche, depuis l'Afrique de l'Ouest : elles restent
# sur R2, dont l'egress est gratuit et le cache réparti.
# ═══════════════════════════════════════════════════════════════════════════════
{% if use_minio_for_kyb | default(false) %}
# MinIO sur le VPS base, joint par le tunnel. En http : le chiffrement est celui de
# WireGuard, et poser du TLS par-dessus imposerait de gérer un certificat pour
# rechiffrer un flux qui l'est déjà. Si ce trafic cessait un jour de passer par le
# tunnel, cette ligne devrait changer AVANT tout le reste.
Storage__KybStorage__ServiceUrl=http://{{ wg_db_ip }}:{{ minio_api_port }}
Storage__KybStorage__AccessKeyId={{ minio_app_access_key }}
Storage__KybStorage__SecretAccessKey={{ minio_app_secret_key }}
Storage__KybStorage__BucketName={{ minio_bucket_kyb }}
Storage__KybStorage__Region={{ minio_region }}
{% else %}
# Cloudflare R2. `ServiceUrl` vide : l'endpoint est déduit de l'identifiant de compte.
Storage__KybStorage__AccountId={{ r2_account_id | default('') }}
Storage__KybStorage__AccessKeyId={{ r2_access_key_id | default('') }}
Storage__KybStorage__SecretAccessKey={{ r2_secret_access_key | default('') }}
Storage__KybStorage__BucketName={{ r2_bucket_name | default('') }}
Storage__KybStorage__Region=auto
{% endif %}
# PublicBaseUrl reste VIDE, dans les deux cas et délibérément : sur un bucket KYB,
# une base publique renseignée rendrait des pièces d'identité lisibles par qui
# devine le nom du fichier. Ces documents ne se lisent que par URL présignée.
Storage__KybStorage__PublicBaseUrl=
