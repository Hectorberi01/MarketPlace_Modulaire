<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Ce BFF référence Marketplace.Api (elle-même une app Web) pour composer
         les modules in-process. Au publish, l'appsettings.json de l'Api entre en
         collision avec celui du BFF (NETSDK1152). On tolère le doublon : les
         valeurs sensibles sont surchargées par variables d'environnement en
         conteneur. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- BFF Vendeur (back-office boutique). Compose les mêmes modules que
       Marketplace.Api (in-process via leurs Contracts) et expose une API agrégée
       /seller/* : gestion de la boutique (KYB, reversement), du catalogue, des
       offres, de l'exécution des commandes (expéditions), des finances (relevé)
       et des avis. Aucune logique métier : orchestration et scoping au vendeur du
       jeton uniquement. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Bootstrap\Marketplace.Api\Marketplace.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

</Project>
