<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Ce BFF référence Marketplace.Api (elle-même une app Web) pour composer
         les modules in-process. Au publish, l'appsettings.json de l'Api entre en
         collision avec celui du BFF (NETSDK1152). On tolère le doublon : les
         valeurs sensibles sont surchargées par variables d'environnement en
         conteneur. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- BFF Admin (back-office plateforme). Compose les mêmes modules que
       Marketplace.Api (in-process via leurs Contracts) et expose une API agrégée
       /admin/* de gouvernance : modération vendeurs (KYB, commission), comptes &
       rôles, modération avis/litiges, opérations commandes/paiements, finances
       (settlement, facturation), catalogue (catégories/marques) et plateforme
       (taxes, marketing, reco, fraude, analytics, stock). Toutes les routes
       exigent le rôle Admin (ou Moderator pour la modération). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Bootstrap\Marketplace.Api\Marketplace.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

</Project>
