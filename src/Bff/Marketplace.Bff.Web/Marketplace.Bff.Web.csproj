<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Ce BFF référence Marketplace.Api (elle-même une app Web) pour composer
         les modules in-process. Au publish, l'appsettings.json de l'Api entre en
         collision avec celui du BFF (NETSDK1152). On tolère le doublon : les
         valeurs sensibles sont surchargées par variables d'environnement en
         conteneur. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- BFF Web (surface navigateur acheteur — SPA/SSR). Compose les mêmes modules
       que Marketplace.Api (in-process via leurs Contracts) et expose une API
       agrégée /web/* pensée pour le web : payloads plus riches que le mobile
       (listing SEO élargi, comparateur multi-produits). Aucune logique métier :
       orchestration et mise en forme uniquement. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Bootstrap\Marketplace.Api\Marketplace.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

</Project>
