{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RunMigrationsAtStartup": false,
  "Jwt": {
    "Issuer": "marketplace",
    "Audience": "marketplace"
  },
  "Dispatch": {
    "Redispatch": {
      "Enabled": true,
      "IntervalSeconds": 10,
      "BatchSize": 50
    },
    "Outbound": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "BatchSize": 50
    }
  }
}
