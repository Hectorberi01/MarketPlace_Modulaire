{
  "AllowedHosts": "*",
  "RunMigrationsAtStartup": false,
  "Jwt": {
    "Issuer": "marketplace",
    "Audience": "marketplace"
  },
  "Dispatch": {
    "Redispatch": {
      "Enabled": true,
      "IntervalSeconds": 10,
      "BatchSize": 50
    },
    "Outbound": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "BatchSize": 50
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
