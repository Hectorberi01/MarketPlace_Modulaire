<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SEUL POINT DE DÉPLOIEMENT DU SERVICE DE DISPATCH.

    Tout ce qui précédait ce projet — domaine, application, persistance, tests — était
    juste : et ne tournait pas. Un service sans hôte n'a ni processus, ni port, ni
    conteneur d'injection, ni tâche de fond. Le code de dispatch le plus soigneux du
    monde n'offre aucune course tant que personne ne l'appelle.

    Il expose DEUX surfaces, authentifiées différemment, et le mélange serait une faute :
      • /internal  — la MARKETPLACE parle au service. Pas de compte, pas de jeton :
        signature HMAC du corps brut, fermée par défaut.
      • /api/courier — l'APPLICATION COURSIER parle au service. Jeton JWT émis par le
        module Identity de la marketplace, clé de signature partagée.
  -->
  <ItemGroup>
    <ProjectReference Include="..\HbaExpress.Dispatch.Application\HbaExpress.Dispatch.Application.csproj" />
    <ProjectReference Include="..\HbaExpress.Dispatch.Infrastructure\HbaExpress.Dispatch.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />

    <!-- Backplane SignalR : indispensable dès que ce service tourne en plusieurs
         instances, ce que le verrou de ligne rend désormais possible. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />

    <!-- Observabilité : mêmes paquets et mêmes versions que le monolithe, pour que les
         deux services produisent des journaux et des métriques exploitables ensemble. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>
